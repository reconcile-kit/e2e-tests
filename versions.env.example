# Скопируйте в versions.env и подставьте ревизии, затем:
#   set -a && source versions.env && set +a && make prepare-deps
#
# База: ветка/тег/SHA, или каталог монорепо (подкаталоги api, controlloop, … с go.mod):
FRAMEWORK_REF=main
# FRAMEWORK_REF=/path/to/monorepo

# Точечные переопределения — ветка, тег, SHA, pr/<N>, или путь к локальному модулю:
# API_REF=/path/to/api
# API_REF=../api
# API_REF=v0.0.16
# API_REF=pr/17
# CONTROLLOOP_REF=v0.0.15
# STATE_MANAGER_PROVIDER_REF=v0.0.9
# REDIS_INFORMER_PROVIDER_REF=v0.0.4
# RUNTIME_MANAGER_REF=v0.0.15
# STATE_MANAGER_REF=v0.0.1
# STATE_MANAGER_REF=pr/42
